[Unit]
Description=bypassd - automatic OnePlus/OPlus bypass charging over ADB
Documentation=https://github.com/ayush-pokhrel/android-bypass-charging-daemon

[Service]
Type=simple
# Optional overrides; the leading "-" means the file may be absent.
EnvironmentFile=-%h/.config/bypassd/bypassd.conf
ExecStart=%h/.local/bin/bypassd
Restart=on-failure
RestartSec=5
# Exit code 78 = invalid configuration; restarting would not help.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
