#!/usr/bin/env bash
#
# bypassd
#
# Automatically enables OnePlus/OPlus Bypass Charging whenever the
# device connects over ADB.
#
# Requirements:
#   - adb installed
#   - USB debugging enabled
#
# Install:
#   chmod +x ~/.local/bin/bypassd
#
# Optional:
#   Run as a systemd user service.

set -euo pipefail

# -------------------------
# Configuration
# -------------------------

# Charging limit (20, 40, 60, or 80)
LIMIT=80

# 1 = Enable bypass charging
# 0 = Disable bypass charging
STATE=1

# Seconds to wait after a new ADB connection
CONNECT_DELAY=3

# Poll interval
POLL_INTERVAL=2

last_state=""

while true; do
    current_state="$(adb get-state 2>/dev/null || true)"

    if [[ "$current_state" == "device" && "$last_state" != "device" ]]; then
        echo "[bypassd] Device connected."

        sleep "$CONNECT_DELAY"

        current_limit="$(adb shell settings get system bypass_charge_value 2>/dev/null | tr -d '\r')"
        current_bypass="$(adb shell settings get system bypass_charge_state 2>/dev/null | tr -d '\r')"

        if [[ "$current_limit" != "$LIMIT" ]]; then
            echo "[bypassd] Setting charge limit to ${LIMIT}%..."
            adb shell settings put system bypass_charge_value "$LIMIT"
        fi

        if [[ "$current_bypass" != "$STATE" ]]; then
            echo "[bypassd] Enabling bypass charging..."
            adb shell settings put system bypass_charge_state "$STATE"
        fi

        echo "[bypassd] Done."
    fi

    last_state="$current_state"
    sleep "$POLL_INTERVAL"
done
